{
  "name": "url-pinger",
  "version": "1.0.0",
  "description": "Hit selected URLs on a fixed interval and record status, latency and errors (Express + HTMX)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "build:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --watch",
    "vendor:htmx": "node scripts/vendor-htmx.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.78.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "daisyui": "^4.12.14",
    "htmx.org": "^1.9.12",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "vitest": "^3.2.7"
  }
}
