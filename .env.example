# Copy to .env and adjust. Placeholders only, never commit real secrets.

# HTTP server. In file mode the app has no authentication, so keep HOST on
# loopback unless you put an authenticating proxy in front of it.
PORT=3200
HOST=127.0.0.1

# Where targets.json is stored (relative to the project root by default)
DATA_DIR=./data

# Interval bounds, in seconds, accepted for a target. The ceiling is 2073600
# (24 days), the largest delay setInterval can hold.
MIN_INTERVAL_SECONDS=5
MAX_INTERVAL_SECONDS=604800

# Largest number of targets per account (the only account in file mode)
MAX_TARGETS=50

# Largest number of targets across all accounts. One process runs every timer.
MAX_TOTAL_TARGETS=500

# Per-hit network timeout in milliseconds
REQUEST_TIMEOUT_MS=10000

# Newest hits per target used for the card stats (success rate, average time)
# and kept with their response previews.
HISTORY_LIMIT=100

# The History panel lists hits from this many past hours, newest first, in
# pages of HISTORY_PAGE_SIZE (max 500). The window is capped at 168 (7 days). In file mode every hit in the window
# is held in memory (17,280 per target per day at a 5 s interval); in
# Supabase mode the window is read from the database.
HISTORY_WINDOW_HOURS=24
HISTORY_PAGE_SIZE=100

# Longest response body slice stored for targets with previews turned on.
# Set to 0 to disable previews for every target.
PREVIEW_LIMIT=500

# Request size limits
BODY_LIMIT=64kb
MAX_REQUEST_BODY_CHARS=10000

# SSRF protection. When false, target URLs pointing at localhost, private
# ranges or cloud metadata endpoints are rejected. Only set true in a trusted
# environment where internal targets are the point.
ALLOW_PRIVATE_TARGETS=false

# When true, stored request header values are shown in the UI and API instead
# of being masked. Headers often carry API tokens, so leave this false unless
# you are debugging and the screen is yours alone.
REVEAL_HEADER_VALUES=false

# Supabase mode: set all three to store targets and hits in Supabase and
# require a login. Leave all three empty for local file mode. Values come from
# Project Settings > API in the Supabase dashboard. Put real values only in
# .env (gitignored) or your secrets manager, never in this file.
# The service role key bypasses Row Level Security: server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stored hits older than this many days are deleted (Supabase mode).
HIT_RETENTION_DAYS=30

# Seconds between reloads of the target list from Supabase, which picks up
# rows changed outside this app (deleted users, dashboard edits). Min 10.
TARGET_SYNC_SECONDS=60

# Number of reverse proxies in front of the app (e.g. 1 for nginx). Needed so
# the login rate limit sees real client IPs. 0 when reached directly.
TRUST_PROXY=0

# Marks session cookies Secure (https only). Defaults to true unless HOST is a
# loopback address and TRUST_PROXY is 0. Keep true for any deployment behind
# https.
# COOKIE_SECURE=true
