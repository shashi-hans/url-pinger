# Copy to .env and adjust. Placeholders only, never commit real secrets.

# HTTP server. The app has no authentication, so keep HOST on loopback unless
# you put an authenticating proxy in front of it.
PORT=3200
HOST=127.0.0.1

# Where targets.json is stored (relative to the project root by default)
DATA_DIR=./data

# Interval bounds, in seconds, accepted for a target. The ceiling is 2073600
# (24 days), the largest delay setInterval can hold.
MIN_INTERVAL_SECONDS=5
MAX_INTERVAL_SECONDS=604800

# Largest number of targets that may be created
MAX_TARGETS=50

# Per-hit network timeout in milliseconds
REQUEST_TIMEOUT_MS=10000

# Hits kept in memory per target (newest first). History is not persisted.
HISTORY_LIMIT=100

# Longest response body slice stored for targets with previews turned on.
# Set to 0 to disable previews for every target.
PREVIEW_LIMIT=500

# Request size limits
BODY_LIMIT=64kb
MAX_REQUEST_BODY_CHARS=10000

# SSRF protection. When false, target URLs pointing at localhost, private
# ranges or cloud metadata endpoints are rejected. Only set true in a trusted
# environment where internal targets are the point.
ALLOW_PRIVATE_TARGETS=false

# When true, stored request header values are shown in the UI and API instead
# of being masked. Headers often carry API tokens, so leave this false unless
# you are debugging and the screen is yours alone.
REVEAL_HEADER_VALUES=false
